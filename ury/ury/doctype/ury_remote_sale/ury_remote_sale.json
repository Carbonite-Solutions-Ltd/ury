 "fields": [
  {
   "fieldname": "intro_html",
   "fieldtype": "HTML",
   "label": "",
   "options": "<div class=\"alert alert-info\">A <b>read-only mirror</b> of a sale made on a branch site. Deliberately not a POS Invoice: replicating a real POS Invoice here would fire <code>pos_invoice_naming</code> (re-assigning its name), <code>validate_pos_opening_entry</code> (which throws \u2014 the cloud has no open shift) and <code>set_order_number</code> (recomputing from the wrong baseline). These rows carry no hooks, no links to masters and no accounting, so an insert can never fail on state this site does not have.</div>"
  },
  {
   "fieldname": "remote_key",
   "fieldtype": "Data",
   "label": "Remote Key",
   "reqd": 1,
   "unique": 1,
   "read_only": 1,
   "description": "'<source site>|<invoice name>' \u2014 the primary key. Scoping by site keeps two branches from colliding even if per-branch invoice prefixes were never configured, and makes re-delivery of the same sale a no-op."
  },
