 "html": "\r\n<style>\r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n        font-weight: bold !important;\r\n    }\r\n    \r\n    @media screen {\r\n        .print-format {\r\n            width: 3in;\r\n            padding: 0.1in;\r\n            min-height: 3in;\r\n        }\r\n    }\r\n    \r\n    .kot-print {\r\n        font-family: monospace;\r\n        font-size: 9pt;\r\n        width: 100%;\r\n        line-height: 1.3;\r\n    }\r\n    \r\n    .kot-header {\r\n        text-align: center;\r\n        font-weight: bold;\r\n        font-size: 11pt;\r\n        margin-bottom: 5px;\r\n        border-bottom: 2px solid #000;\r\n        padding-bottom: 3px;\r\n    }\r\n    \r\n    .kot-info {\r\n        margin: 5px 0;\r\n        font-size: 9pt;\r\n    }\r\n    \r\n    .kot-info div {\r\n        margin: 1px 0;\r\n        display: table;\r\n        width: 100%;\r\n    }\r\n    \r\n    .kot-info span:first-child {\r\n        display: table-cell;\r\n        width: 35%;\r\n        font-weight: bold;\r\n    }\r\n    \r\n    .kot-info span:last-child {\r\n        display: table-cell;\r\n        width: 65%;\r\n    }\r\n    \r\n    .kot-items {\r\n        margin: 8px 0;\r\n        border-top: 1px dashed #000;\r\n        border-bottom: 1px dashed #000;\r\n        padding: 5px 0;\r\n    }\r\n    \r\n    .kot-item {\r\n        margin: 4px 0;\r\n        page-break-inside: avoid;\r\n    }\r\n    \r\n    .item-line {\r\n        line-height: 1.4;\r\n    }\r\n    \r\n    .item-qty {\r\n        font-weight: bold;\r\n        font-size: 11pt;\r\n        display: inline-block;\r\n        min-width: 30px;\r\n    }\r\n    \r\n    .item-name {\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n    }\r\n    \r\n    .item-comment,\r\n    .item-notes {\r\n        margin-left: 30px;\r\n        font-style: italic;\r\n        color: #333;\r\n        margin-top: 2px;\r\n        font-size: 8pt;\r\n        line-height: 1.2;\r\n    }\r\n    \r\n    .kot-footer {\r\n        text-align: center;\r\n        margin-top: 8px;\r\n        font-size: 9pt;\r\n        border-top: 1px dashed #000;\r\n        padding-top: 5px;\r\n    }\r\n    \r\n    .kot-footer div {\r\n        margin: 3px 0;\r\n    }\r\n</style>\r\n\r\n<div class=\"kot-print\">\r\n    <div class=\"kot-header\">\r\n        KITCHEN ORDER TICKET\r\n    </div>\r\n\r\n    <div class=\"kot-info\">\r\n        <div>\r\n            <span>KOT #:</span>\r\n            <span>{{ doc.name }}</span>\r\n        </div>\r\n        <div>\r\n            <span>Date:</span>\r\n            <span>{{ frappe.utils.format_date(doc.date, \"dd-MM-yyyy\") }}</span>\r\n        </div>\r\n        <div>\r\n            <span>Time:</span>\r\n            <span>{{ doc.time }}</span>\r\n        </div>\r\n        {% if doc.restaurant_table %}\r\n        <div>\r\n            <span>Table:</span>\r\n            <span>{{ doc.restaurant_table }}</span>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <div class=\"kot-items\">\r\n        {% for item in doc.kot_items %}\r\n        <div class=\"kot-item\">\r\n            <div class=\"item-line\">\r\n                <span class=\"item-qty\">{{ item.quantity }}x</span>\r\n                <span class=\"item-name\">{{ item.item_name }}</span>\r\n            </div>\r\n            {% if item.comments %}\r\n            <div class=\"item-comment\">\r\n                {{ item.comments }}\r\n            </div>\r\n            {% endif %}\r\n            {% if item.notes %}\r\n            <div class=\"item-notes\">\r\n                NOTE: {{ item.notes }}\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n        {% endfor %}\r\n    </div>\r\n\r\n    <div class=\"kot-footer\">\r\n        {% if doc.comments %}\r\n        <div>\r\n            <strong>Special Instructions:</strong><br>\r\n            {{ doc.comments }}\r\n        </div>\r\n        {% endif %}\r\n        <div>\r\n            <strong>Status:</strong> {{ doc.order_status }}\r\n        </div>\r\n    </div>\r\n</div>\r\n",
